{
  "name": "@mms/shared",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tenantUtils": {
      "import": "./dist/tenantUtils.js",
      "default": "./dist/tenantUtils.js",
      "types": "./dist/tenantUtils.d.ts"
    },
    "./translations/en": {
      "import": "./dist/appTranslationsEn.js",
      "default": "./dist/appTranslationsEn.js",
      "types": "./dist/appTranslationsEn.d.ts"
    },
    "./translations/ar": {
      "import": "./dist/appTranslationsAr.js",
      "default": "./dist/appTranslationsAr.js",
      "types": "./dist/appTranslationsAr.d.ts"
    },
    "./translations/ur": {
      "import": "./dist/appTranslationsUr.js",
      "default": "./dist/appTranslationsUr.js",
      "types": "./dist/appTranslationsUr.d.ts"
    },
    "./translations/fa": {
      "import": "./dist/appTranslationsFa.js",
      "default": "./dist/appTranslationsFa.js",
      "types": "./dist/appTranslationsFa.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "NODE_OPTIONS='-r ../../scripts/eslint-ts-compat.cjs' eslint . --quiet",
    "test": "vitest run"
  },
  "dependencies": {
    "@ts-rest/core": "^3.52.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
