#!/usr/bin/env bash
# Git hook: Local CI verification before commit
set -euo pipefail

if [[ "${SKIP_LOCAL_CI:-}" == "1" ]]; then
  echo "⚠ SKIP_LOCAL_CI=1 — skipping local CI before commit (agents must not set this unless the user asks)."
  exit 0
fi

echo "🔍 Running pre-commit verification & local CI (pnpm ci:local)..."

# 1. Check for staged secrets/credentials
pnpm run check:secrets

# 2. Run path-aware local CI (quality gates + affected unit tests)
pnpm ci:local

echo "✅ Pre-commit verification passed — proceeding with commit."
