#!/usr/bin/env bash
# Git hook: Validate Conventional Commits format
# Expected: type(scope): description
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

exec bash "$ROOT/scripts/ci/validate-conventional-commit.sh" "$commit_msg"
