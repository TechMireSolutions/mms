{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm run check:*)",
      "Bash(node scripts/verify-rules-integrity.mjs)",
      "Bash(bash .agent/scripts/sync-all.sh)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(pnpm publish:*)",
      "Bash(rm -rf /:*)",
      "Bash(drizzle-kit push:*)",
      "Read(./.env)",
      "Read(./apps/backend/.env)",
      "Read(./apps/frontend/.env)",
      "Read(./.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".cursor/hooks/guard-shell.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".cursor/hooks/format-edited-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
