{
  "name": "e2e-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_TARGET=production playwright test --grep @smoke",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:local": "playwright test --grep-invert @local-only",
    "lint": "node -r ../scripts/eslint-ts-compat.cjs node_modules/eslint/bin/eslint.js . --quiet",
    "merge-reports": "playwright merge-reports",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
