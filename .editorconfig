# EditorConfig — consistent base editor settings across tools/IDEs.
# Root of the monorepo. See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Keep markdown as-authored; don't trim trailing spaces (hard line breaks).
trim_trailing_whitespace = false

[*.{sh,cjs}]
indent_size = 2
