{
  "name": "mms-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=mms-frontend --filter=mms-backend",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "test:e2e": "pnpm --filter e2e-tests exec playwright test",
    "check:i18n": "pnpm --filter mms-backend exec tsx ../../scripts/i18n/check-translations.ts",
    "verify:rules": "node scripts/verify-rules-integrity.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:migration-indexes": "node scripts/check-migration-indexes.mjs",
    "check:db-projections": "node scripts/check-db-projections.mjs",
    "check:code-norms": "node scripts/check-code-norms.mjs",
    "check:work-directory": "node scripts/check-work-directory.mjs",
    "check:secrets": "node scripts/check-staged-secrets.mjs",
    "sync:skills-index": "node scripts/sync-skill-index.mjs",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "typescript": "~7.0.2",
    "typescript-v6": "npm:typescript@~6.0.3"
  }
}
